# ─── Frontend (safe to expose — protected by Row Level Security) ───────────
# Leave both empty to run the site in local DEMO MODE with sample content.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── Server-side ONLY (never prefix with VITE_) ───────────────────────────
# Set these as Supabase Edge Function secrets, NOT in Vercel frontend env:
#   supabase secrets set YOUTUBE_API_KEY=... YOUTUBE_CHANNEL_ID=... ALLOWED_ORIGINS=https://your-site.vercel.app
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
ALLOWED_ORIGINS=

# Optional: email notifications for new contact messages (Edge Function "notify-contact")
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
WEBHOOK_SECRET=
